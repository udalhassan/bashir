# Student Voting System Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-make-it-very-long-and-random
SESSION_SECRET=another-super-secret-session-key-for-additional-security

# Database Configuration
DB_PATH=./voting_system.db

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
VOTING_RATE_LIMIT_WINDOW_MS=3600000
VOTING_RATE_LIMIT_MAX_REQUESTS=5

# Security Headers
HELMET_ENABLED=true
CORS_ENABLED=true

# Application Settings
VOTER_CARD_PREFIX=VC
HASH_ROUNDS=12